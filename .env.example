# ---------------------------------------------------------------------------
# FinAgent configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider (planner / reflection / finalize) ------------------------
# One of: anthropic | openai | mock
#   anthropic -> real Claude calls (default, recommended)
#   openai    -> alternate provider for A/B eval (requires `pip install -e .[openai]`)
#   mock      -> deterministic heuristic provider; no key needed, used by tests/CI
LLM_PROVIDER=anthropic

# Anthropic (required when LLM_PROVIDER=anthropic; also powers web_search)
ANTHROPIC_API_KEY=
# Model used for planner/reflect/finalize. A Claude Sonnet-class model is a good
# default (quality for planning, reasonable cost across an eval run).
FINAGENT_MODEL=claude-sonnet-5
# Slightly cheaper model may be used for the reflection node (optional; falls back
# to FINAGENT_MODEL if unset).
FINAGENT_REFLECT_MODEL=

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Tools -----------------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent WITH a contact email, or it 403s.
SEC_EDGAR_USER_AGENT=FinAgent/0.1 (your-email@example.com)

# Web search provider: anthropic | tavily | stub
#   anthropic -> uses the Claude server-side web_search tool (no extra key)
#   tavily    -> requires TAVILY_API_KEY and `pip install -e .[tavily]`
#   stub      -> returns a canned note (offline/CI)
WEB_SEARCH_PROVIDER=anthropic
TAVILY_API_KEY=

# --- RAG (optional; requires `pip install -e .[rag]`) -----------------------
# Embedding provider: voyage | openai
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Where the Chroma persistent store lives.
CHROMA_DIR=data/chroma
